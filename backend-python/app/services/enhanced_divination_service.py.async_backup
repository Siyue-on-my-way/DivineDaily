"""增强占卜服务（集成智能预处理、路由和LLM）

本服务提供完整的占卜流程：
1. 异步占卜执行（避免超时）
2. 问题分析和意图识别
3. 智能路由到不同占卜类型
4. LLM 增强解读
5. 完善的错误处理和资源管理
"""

from typing import Dict, Any, Optional
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy import select
from app.services.divination_service import DivinationService
from app.services.intent_service import IntentRecognitionService
from app.services.question_analyzer import QuestionAnalyzer
from app.services.divination_router import DivinationRouter
from app.services.prompt_builder import PromptBuilder
from app.services.llm_service import LLMService, create_llm_service
from app.repositories.llm_repository import LLMRepository
from app.repositories.config_repository import PromptConfigRepository
from app.models.divination import DivinationSession as DivinationSessionModel
from app.core.divination_exceptions import (
    DivinationProcessingError,
    LLMEnhancementError,
    DatabaseConnectionError
)
import traceback
import asyncio
import uuid
from datetime import datetime

from app.core.logger import get_logger
logger = get_logger("divination.enhanced")


class EnhancedDivinationService(DivinationService):
    """
    增强占卜服务
    
    提供智能预处理、路由和 LLM 增强功能的占卜服务
    支持异步后台执行，避免长时间占卜导致的超时问题
    """
    
    def __init__(self, db: AsyncSession, llm_service: Optional[LLMService] = None):
        """
        初始化增强占卜服务
        
        Args:
            db: 数据库会话
            llm_service: LLM 服务实例（可选）
        """
        # 初始化仓库
        self.llm_repo = LLMRepository(db)
        self.prompt_repo = PromptConfigRepository(db)
        
        # 调用父类初始化,传递LLM相关参数
        super().__init__(db, llm_service=llm_service, prompt_repo=self.prompt_repo, llm_repo=self.llm_repo)
        
        self.llm_service = llm_service
        self.intent_service = IntentRecognitionService(db, llm_service)
        self.question_analyzer = QuestionAnalyzer(llm_service)
        self.router = DivinationRouter(db)
        self.daily_fortune_service = None
        logger.debug(f"EnhancedDivinationService初始化，llm_service={'有' if llm_service else '无'}")
    

    async def start_divination_async(self, request) -> Dict[str, Any]:
        """
        异步启动占卜（立即返回 session_id，后台执行占卜）
        
        这是解决占卜超时问题的核心方法：
        1. 立即创建占卜会话并返回 session_id
        2. 在后台异步执行完整的占卜流程
        3. 前端通过轮询获取占卜结果
        
        Args:
            request: 占卜请求对象，包含 user_id, question, version 等字段
            
        Returns:
            Dict 包含 session_id, status, created_at
            
        Raises:
            DatabaseConnectionError: 数据库连接失败
        """
        # 生成唯一的 session_id
        session_id = str(uuid.uuid4())
        
        logger.info(f"创建占卜会话: {session_id}, 用户: {request.user_id}, 问题: {request.question[:50]}...")
        
        try:
            # 创建初始 session 记录（状态为 processing）
            session = DivinationSessionModel(
                id=session_id,
                user_id=request.user_id,
                version=request.version,
                question=request.question,
                event_type=request.event_type or 'general',
                orientation=request.orientation,
                status='processing',
                result_summary=None,
                result_detail=None
            )
            self.db.add(session)
            await self.db.commit()
            
            logger.info(f"占卜会话已创建: {session_id}")
        except Exception as e:
            logger.error(f"创建占卜会话失败: {e}")
            traceback.print_exc()
            raise DatabaseConnectionError(f"创建占卜会话失败: {str(e)}")
        
        # 在后台执行占卜（不等待完成）
        asyncio.create_task(self._execute_divination_background(request, session_id))
        
        # 立即返回 session_id
        return {
            'session_id': session_id,
            'status': 'processing',
            'created_at': datetime.now()
        }
    
    async def _execute_divination_background(self, request, session_id: str):
        """
        后台执行占卜任务
        
        在独立的异步任务中执行完整的占卜流程，包括：
        1. 问题分析
        2. 意图识别
        3. 智能路由
        4. LLM 增强解读
        
        注意：此方法在后台运行，不会阻塞主请求
        所有异常都会被捕获并记录到数据库
        使用独立的数据库会话，避免与主请求会话冲突
        
        Args:
            request: 占卜请求对象
            session_id: 占卜会话ID
        """
        from app.core.database import async_session_maker
        
        start_time = datetime.now()
        
        # 创建独立的数据库会话用于后台任务
        async with async_session_maker() as background_db:
            try:
                logger.info(f"后台占卜任务开始: {session_id}")
                
                # 创建新的服务实例，使用独立的数据库会话
                background_service = EnhancedDivinationService(background_db, self.llm_service)
                background_service.daily_fortune_service = self.daily_fortune_service
                
                # 执行完整的占卜流程
                result = await background_service._do_divination_with_enhancement(request, session_id)
                
                elapsed = (datetime.now() - start_time).total_seconds()
                logger.info(f"后台占卜任务完成: {session_id}, 耗时: {elapsed:.2f}秒")
                
            except LLMEnhancementError as e:
                # LLM 增强失败，但基础占卜可能已完成
                logger.warning(f"LLM 增强失败: {session_id}, {e}")
                traceback.print_exc()
                # 不更新为失败状态，因为基础结果可能已保存
                
            except Exception as e:
                # 其他错误，标记为失败
                logger.error(f"后台占卜任务失败: {session_id}, {type(e).__name__}: {e}")
                traceback.print_exc()
                
                # 更新状态为失败（使用后台会话）
                try:
                    result = await background_db.execute(
                        select(DivinationSessionModel).where(
                            DivinationSessionModel.id == session_id
                        )
                    )
                    session = result.scalar_one_or_none()
                    if session:
                        session.status = 'failed'
                        error_msg = f"占卜失败: {type(e).__name__}"
                        if str(e):
                            error_msg += f" - {str(e)}"
                        session.result_summary = error_msg
                        await background_db.commit()
                        logger.info(f"已更新会话状态为失败: {session_id}")
                except Exception as db_error:
                    logger.error(f"更新失败状态时出错: {db_error}")
                    traceback.print_exc()
    
    async def _do_divination_with_enhancement(self, request, session_id: str):
        """
        执行完整的占卜流程（包括 LLM 增强）
        
        完整流程：
        1. 问题分析（使用 LLM 或规则引擎）
        2. 意图识别
        3. 智能路由（根据问题类型选择占卜方式）
        4. LLM 增强解读（摘要和详情）
        5. 更新数据库
        
        Args:
            request: 占卜请求对象
            session_id: 占卜会话ID
            
        Returns:
            DivinationResult: 占卜结果对象
            
        Raises:
            DivinationProcessingError: 占卜处理失败
            LLMEnhancementError: LLM 增强失败
        """
        
        logger.info(f"开始增强占卜流程，会话: {session_id}, 问题: {request.question}")
        
        # 步骤1：问题分析
        analysis = None
        if self.llm_service:
            try:
                analysis = await self.question_analyzer.analyze_question(request.question)
                logger.info(f"问题分析完成 - 类型: {analysis.question_type}, 子类型: {analysis.sub_type}, 复杂度: {analysis.complexity}")
            except Exception as e:
                logger.warning(f"问题分析失败，使用规则引擎降级: {e}")
        
        if not analysis:
            analysis = self.question_analyzer._fallback_analysis(request.question)
        
        # 步骤2：意图识别
        try:
            intent_result = self.intent_service.analyze_intent(request.question, request.user_id)
            logger.info(f"意图识别完成")
        except Exception as e:
            logger.warning(f"意图识别失败: {e}")
            intent_result = None
        
        # 步骤3：保存意图记录
        if intent_result:
            try:
                await self.intent_service.save_intent(request.question, intent_result, request.user_id)
                await self.db.commit()
            except Exception as e:
                logger.warning(f"保存意图记录失败: {e}")
        
        # 步骤4：智能路由
        logger.info(f"开始智能路由...")
        try:
            divination_result = await self.router.route_question(
                session_id=session_id,
                question=request.question,
                user_id=request.user_id,
                analysis=analysis,
                divination_service=self,
                daily_fortune_service=self.daily_fortune_service
            )
            logger.info(f"路由处理完成，卦象信息: {'有' if divination_result.hexagram_info else '无'}")
        except Exception as e:
            logger.error(f"路由处理失败，使用基础占卜降级: {e}")
            traceback.print_exc()
            # 降级到基础占卜
            request_copy = type(request)(
                user_id=request.user_id,
                question=request.question,
                version=request.version,
                event_type=request.event_type,
                orientation=request.orientation
            )
            divination_result = await self.start_divination(request_copy)
        
        # 步骤5：LLM 增强
        if self.llm_service and divination_result.hexagram_info:
            try:
                logger.info(f"开始LLM增强解读...")
                llm_start_time = datetime.now()
                
                enhanced_summary = await self._enhance_summary(
                    request.question,
                    divination_result.hexagram_info,
                    analysis
                )
                
                enhanced_detail = await self._enhance_detail(
                    request.question,
                    divination_result.hexagram_info
                )
                
                llm_elapsed = (datetime.now() - llm_start_time).total_seconds()
                logger.info(f"LLM增强完成，耗时: {llm_elapsed:.2f}秒")
                
                # 更新数据库
                result = await self.db.execute(
                    select(DivinationSessionModel).where(
                        DivinationSessionModel.id == session_id
                    )
                )
                session = result.scalar_one_or_none()
                if session:
                    session.result_summary = enhanced_summary
                    session.result_detail = enhanced_detail
                    session.status = 'completed'
                    if session.result_data:
                        session.result_data['summary'] = enhanced_summary
                        session.result_data['detail'] = enhanced_detail
                    await self.db.commit()
                    logger.info(f"LLM增强结果已保存到数据库")
                else:
                    logger.warning(f"未找到会话记录: {session_id}")
                    
            except Exception as e:
                logger.error(f"LLM增强失败: {type(e).__name__}: {e}")
                traceback.print_exc()
                raise LLMEnhancementError(f"LLM增强失败: {str(e)}")
        else:
            logger.info(f"跳过LLM增强（llm_service: {'有' if self.llm_service else '无'}, hexagram_info: {'有' if divination_result.hexagram_info else '无'}）")
        
        return divination_result
    
    async def _enhance_summary(self, question: str, hexagram_info: Dict[str, Any],
                               analysis: Optional[Any] = None) -> str:
        """
        使用 LLM 增强摘要
        
        Args:
            question: 用户问题
            hexagram_info: 卦象信息
            analysis: 问题分析结果（可选）
            
        Returns:
            str: 增强后的摘要文本
            
        Raises:
            LLMEnhancementError: LLM 调用失败
        """
        
        logger.info(f"开始生成增强摘要")
        
        llm = None
        try:
            # 获取Prompt配置
            prompt_config = await self.prompt_repo.get_by_scene_and_type("divination", "answer")
            
            if prompt_config and prompt_config.llm_config_id:
                # 使用配置的LLM
                llm_config = await self.llm_repo.get_by_id(prompt_config.llm_config_id)
                if llm_config:
                    llm = create_llm_service(
                        llm_config,
                        temperature=prompt_config.temperature,
                        max_tokens=prompt_config.max_tokens,
                        timeout=prompt_config.timeout_seconds
                    )
                    
                    # 构建Prompt
                    prompt = PromptBuilder.build_answer_prompt(question, hexagram_info, None, analysis)
                    
                    # 调用LLM
                    enhanced = await llm.generate_answer(prompt)
                    logger.info(f"增强摘要生成完成，长度: {len(enhanced)}")
                    return enhanced
            
            # 降级：使用默认LLM或返回原始摘要
            if self.llm_service:
                prompt = PromptBuilder.build_answer_prompt(question, hexagram_info, None, analysis)
                enhanced = await self.llm_service.generate_answer(prompt)
                logger.info(f"使用默认LLM生成摘要，长度: {len(enhanced)}")
                return enhanced
            
            # 最终降级：返回原始摘要
            logger.warning(f"无可用LLM，返回原始摘要")
            return hexagram_info.get('summary', '')
            
        except Exception as e:
            logger.error(f"生成增强摘要失败: {e}")
            raise LLMEnhancementError(f"生成增强摘要失败: {str(e)}")
        finally:
            # 确保 LLM 客户端被正确关闭
            if llm and hasattr(llm, 'close'):
                try:
                    await llm.close()
                    logger.debug(f"LLM 客户端已关闭（摘要）")
                except Exception as e:
                    logger.warning(f"关闭 LLM 客户端失败: {e}")
    
    async def _enhance_detail(self, question: str, hexagram_info: Dict[str, Any]) -> str:
        """
        使用 LLM 增强详情
        
        Args:
            question: 用户问题
            hexagram_info: 卦象信息
            
        Returns:
            str: 增强后的详情文本
            
        Raises:
            LLMEnhancementError: LLM 调用失败
        """
        
        logger.info(f"开始生成增强详情")
        
        llm = None
        try:
            # 获取Prompt配置
            prompt_config = await self.prompt_repo.get_by_scene_and_type("divination", "detail")
            
            if prompt_config and prompt_config.llm_config_id:
                # 使用配置的LLM
                llm_config = await self.llm_repo.get_by_id(prompt_config.llm_config_id)
                if llm_config:
                    llm = create_llm_service(
                        llm_config,
                        temperature=prompt_config.temperature,
                        max_tokens=prompt_config.max_tokens,
                        timeout=prompt_config.timeout_seconds
                    )
                    
                    # 构建Prompt
                    prompt = PromptBuilder.build_detail_prompt(question, hexagram_info)
                    
                    # 调用LLM
                    enhanced = await llm.generate_detail(prompt)
                    logger.info(f"增强详情生成完成，长度: {len(enhanced)}")
                    return enhanced
            
            # 降级：使用默认LLM或返回原始详情
            if self.llm_service:
                prompt = PromptBuilder.build_detail_prompt(question, hexagram_info)
                enhanced = await self.llm_service.generate_detail(prompt)
                logger.info(f"使用默认LLM生成详情，长度: {len(enhanced)}")
                return enhanced
            
            # 最终降级：返回原始详情
            logger.warning(f"无可用LLM，返回原始详情")
            return hexagram_info.get('detail', '')
            
        except Exception as e:
            logger.error(f"生成增强详情失败: {e}")
            raise LLMEnhancementError(f"生成增强详情失败: {str(e)}")
        finally:
            # 确保 LLM 客户端被正确关闭
            if llm and hasattr(llm, 'close'):
                try:
                    await llm.close()
                    logger.debug(f"LLM 客户端已关闭（详情）")
                except Exception as e:
                    logger.warning(f"关闭 LLM 客户端失败: {e}")
